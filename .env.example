# Honeyswarm environment. Copy to .env and set the secrets:
#   cp .env.example .env  &&  docker compose up -d
# MQTT TLS certs + password file are generated automatically on first boot
# (the mqtt-init service) — nothing else to run.

# General
TIMEZONE=Europe/London
LOG_LEVEL=INFO
# Base URL agents use to reach the controller (shown in the enrollment install
# command). Enrollment goes through the Caddy HTTPS edge — NOT the API's :8080,
# which is no longer published to the host. For a remote deployment set this to
# the controller's public URL, e.g. https://honeyswarm.example.com
PUBLIC_URL=https://localhost
# Whether agents verify the controller's TLS cert when enrolling. Leave false for
# the default self-signed edge cert (the install one-liner gets curl -k). Set true
# once PUBLIC_URL points at a domain with a trusted (Let's Encrypt) cert.
AGENT_TLS_VERIFY=false
# Host agents use to reach the MQTT broker. For a remote deployment set this to
# the controller's public hostname/IP — it is baked into the broker cert's SAN.
MQTT_PUBLIC_HOST=localhost
# Optional extra cert SANs (space-separated hostnames/IPs).
MQTT_EXTRA_SANS=
MANIFESTS_DIR=/opt/honeyswarm/manifests
# Published hive agent image used in the enrollment install command
AGENT_IMAGE=ghcr.io/honeyswarm/honeyswarm-agent:latest

# Auth / JWT  — CHANGE JWT_SECRET and ADMIN_PASSWORD for anything non-local
JWT_SECRET=CHANGE_ME_I_AM_NOT_SECURE
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14

# Bootstrap admin (created on first startup if no users exist)
ADMIN_EMAIL=admin@honeyswarm.local
ADMIN_PASSWORD=CHANGE_ME_admin_pw

# MongoDB
MONGODB_HOST=mongo
MONGODB_PORT=27017
MONGODB_USERNAME=CHANGE_ME
MONGODB_PASSWORD=CHANGE_ME
MONGODB_AUTH_SOURCE=admin
MONGODB_DATABASE=honeyswarm

# OpenSearch
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=CHANGE_ME_Str0ng!
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_EVENT_INDEX=honeyswarm-events
# OpenSearch Dashboards saved-objects API (used to auto-create the events index
# pattern so Discover works out of the box). Includes the /dashboards basePath.
OPENSEARCH_DASHBOARDS_URL=http://opensearch-dashboards:5601/dashboards
# The OpenSearch security plugin stays OFF: the trust boundary is the edge proxy
# (Caddy) + the private docker network. OpenSearch/Dashboards are never published
# to the host and are reached only through the authenticated reverse proxy.
OPENSEARCH_DISABLE_SECURITY=true

# --- Edge TLS + Dashboards access ---------------------------------------------
# Dashboards is NOT published to the host. It is served at https://<host>/dashboards
# behind Caddy, gated by SINGLE SIGN-ON against your Honeyswarm login (no separate
# Dashboards password). TLS terminates at Caddy; internal hops are plain HTTP.
#
# Default :443 = self-signed HTTPS that works on any hostname/IP out of the box
# (Caddy issues internal certs on demand; browsers warn until you trust its root
# CA). For a public domain with real Let's Encrypt certs: set SITE_ADDRESS to the
# domain and edit web/Caddyfile's `tls internal { on_demand }` line to your email.
SITE_ADDRESS=:443
# Set the Secure flag on the SSO cookie. Keep true (we serve HTTPS). Only set
# false if you deliberately run the edge on plain HTTP.
COOKIE_SECURE=true

# MQTT (mutual TLS by default — CA + per-hive client certs auto-generated into the
# mqtt_secrets volume). Each hive authenticates with its own client cert (CN ==
# hive id) and is confined by the ACL to its own hive/<id>/* topics, so a
# compromised hive cannot impersonate or command any other.
MQTT_HOST=mqtt
MQTT_PORT=8883
# Controller identity: the broker maps the client cert CN to the MQTT username,
# which must match the controller user in mqtt/acl ("honeyswarm").
MQTT_USERNAME=honeyswarm
# Deprecated under mTLS (no shared password is issued). Left for back-compat;
# safe to leave unset.
MQTT_PASSWORD=
MQTT_USE_TLS=true
MQTT_CA_CERT=/secrets/ca.crt
MQTT_CA_KEY=/secrets/ca.key
MQTT_CLIENT_CERT=/secrets/client-honeyswarm.crt
MQTT_CLIENT_KEY=/secrets/client-honeyswarm.key
