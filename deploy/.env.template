# Honeyswarm v2 environment. Copy to deploy/.env and fill in secrets.

# General
TIMEZONE=Europe/London
LOG_LEVEL=INFO
# URL agents use to reach the controller (shown in the install one-liner)
PUBLIC_URL=http://localhost:8080
# Host agents use to reach the MQTT broker
MQTT_PUBLIC_HOST=localhost
MANIFESTS_DIR=/opt/honeyswarm/manifests
# Published hive agent image used in the enrollment install command
AGENT_IMAGE=ghcr.io/honeyswarm/honeyswarm-agent:latest

# Auth / JWT
JWT_SECRET=CHANGE_ME_I_AM_NOT_SECURE
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14

# Bootstrap admin (created on first startup if no users exist)
ADMIN_EMAIL=admin@honeyswarm.local
ADMIN_PASSWORD=CHANGE_ME_admin_pw

# MongoDB
MONGODB_HOST=mongo
MONGODB_PORT=27017
MONGODB_USERNAME=CHANGE_ME
MONGODB_PASSWORD=CHANGE_ME
MONGODB_AUTH_SOURCE=admin
MONGODB_DATABASE=honeyswarm

# OpenSearch
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=CHANGE_ME_Str0ng!
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_EVENT_INDEX=honeyswarm-events
# Set to false to enable the OpenSearch security plugin (then set USE_SSL/auth).
OPENSEARCH_DISABLE_SECURITY=true

# MQTT
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_USERNAME=honeyswarm
MQTT_PASSWORD=CHANGE_ME
MQTT_USE_TLS=false
